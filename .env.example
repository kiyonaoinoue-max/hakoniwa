# ===========================
# Hakoniwa AI — 環境変数テンプレート
# ===========================
# このファイルを .env.local にコピーして値を設定してください
# cp .env.example .env.local

# --- Gemini API ---
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VITE_GEMINI_API_KEY_2=
# サーバーサイド用（Vercel環境変数に設定）
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Google OAuth（Web版ログイン用） ---
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET_HERE
LINE_USER_ID=YOUR_LINE_USER_ID_HERE

# --- Google Service Account（サーバーサイドDriveアクセス用） ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT@PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
HAKONIWA_DRIVE_FILE_ID=YOUR_DRIVE_FILE_ID_HERE

# --- Cron認証 ---
CRON_SECRET=YOUR_RANDOM_SECRET_HERE

# --- Web版URL（LINE通知からのリンク用） ---
HAKONIWA_WEB_URL=https://your-app.vercel.app
